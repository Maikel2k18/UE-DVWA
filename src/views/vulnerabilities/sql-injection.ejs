<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/style.css">
    <title>SQL Injection</title>
</head>
<body>
    <div class="container" style="background: white; padding: 40px; border-radius: 20px;">
        <h1>SQL Injection (A03:2021)</h1>
        <p>Busca un usuario por su ID (Prueba con 1, 2 o 3):</p>
        
        <form action="" method="GET">
            <input type="text" name="id" placeholder="ID del usuario" style="padding: 10px;">
            <button type="submit" class="btn btn-vuln">Buscar</button>
        </form>

        <hr>
        <h2>Resultados de la Base de Datos:</h2>
        <table border="1" style="width: 100%; text-align: left; border-collapse: collapse; margin-top: 20px;">
            <thead>
                <tr style="background-color: #f8f9fa;">
                    <th style="padding: 10px;">ID</th>
                    <th style="padding: 10px;">Nombre de Usuario / Info</th>
                    <th style="padding: 10px;">Rol en el Sistema</th>
                </tr>
            </thead>
            <tbody>
                <% if (users.length > 0) { %>
                    <% users.forEach(user => { %>
                        <tr>
                            <td style="padding: 10px;"><%= user.id %></td>
                            <td style="padding: 10px; font-weight: bold;"><%= user.username %></td>
                            <td style="padding: 10px;"><%= user.role %></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="3" style="padding: 20px; text-align: center; color: #666;">
                            No se han encontrado resultados.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        <br>
        <a href="/" class="btn btn-sec">Volver al Panel</a>
    </div>
</body>
</html>